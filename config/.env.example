# App Config
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5000

# DB Config
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sarahah_dev

# Redis Config
REDIS_URL=redis://localhost:6379

# JWT Config
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_ADMIN_ACCESS_SECRET=your_jwt_admin_access_secret
JWT_ADMIN_ACCESS_EXPIRES_IN=7d

JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

JWT_ADMIN_REFRESH_SECRET=your_jwt_admin_refresh_secret
JWT_ADMIN_REFRESH_EXPIRES_IN=7d

JWT_REFRESH_COOKIE_NAME=refreshToken

# CodeGenerator [OTP , etc..]
CODE_CHARACTERS=Your_secret_code_characters

# OTP Config
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5

# Mail Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_FROM="Sarahah Team <your_email@gmail.com>"

CLIENT_URL=http://localhost:3000

# OAuth Config

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub Auth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# Account Verify
LOGIN_MAX_ATTEMPTS=5